---
import { Icon } from 'astro-icon/components'

const feedUrl = new URL('/calendari.ics', Astro.site)
// webcal:// makes iOS/macOS (and most Android calendar apps) offer to
// subscribe instead of importing a one-off copy.
const webcalUrl = feedUrl.href.replace(/^https?:/, 'webcal:')
const googleUrl = `https://calendar.google.com/calendar/r?cid=${encodeURIComponent(webcalUrl)}`
---

<div class="flex flex-wrap items-center justify-center gap-2">
  <a
    href={webcalUrl}
    class="flex items-center gap-2 rounded-full bg-white px-4 py-2 text-sm font-medium text-orange-700 shadow-md transition hover:scale-105 hover:-rotate-2 focus-visible:ring-4 focus-visible:ring-white/50 focus-visible:outline-none"
  >
    <Icon name="tabler:calendar-plus" class="size-5" />
    <span>Afegeix al calendari</span>
  </a>
  <a
    href={googleUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center gap-2 rounded-full px-4 py-2 text-sm font-medium text-white ring-1 ring-white/60 transition hover:bg-white/15 focus-visible:ring-4 focus-visible:ring-white/50 focus-visible:outline-none"
  >
    <Icon name="tabler:brand-google" class="size-5" />
    <span>Google Calendar</span>
  </a>
</div>
